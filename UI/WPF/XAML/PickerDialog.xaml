<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select" Height="500" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="10" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tenant selector. Hidden unless more than one tenant is signed in. -->
        <Grid Name="grdPickerTenant" Grid.Row="0" Margin="0,0,0,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PickerLabel"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Tenant" VerticalAlignment="Center" Padding="0,0,0,0"/>
            <ComboBox Name="cbPickerTenant" Grid.Column="2" DisplayMemberPath="Title" SelectedValuePath="Key"/>
        </Grid>

        <!-- Scope selector. Hidden unless the caller passes -Scopes. -->
        <Grid Name="grdPickerScope" Grid.Row="1" Margin="0,0,0,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PickerLabel"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Search in" VerticalAlignment="Center" Padding="0,0,0,0"/>
            <ComboBox Name="cbPickerScope" Grid.Column="2" DisplayMemberPath="Title" SelectedValuePath="Key"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtPickerSearch" Grid.Column="0" VerticalContentAlignment="Center" Padding="3,2,3,2"/>
            <Button Name="btnPickerSearch" Grid.Column="2" Content="Search" Width="70" Padding="5,2,5,2"/>
        </Grid>

        <DataGrid Name="dgPickerObjects" Grid.Row="3"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  IsReadOnly="True"/>

        <GroupBox Name="grpPickerStatus" Grid.Row="4" Margin="0,5,0,0" Visibility="Collapsed">
            <TextBlock Name="txtPickerStatus" TextWrapping="Wrap"/>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="btnPickerLoadAll" Grid.Column="0" Content="Load all from Intune" Padding="8,2,8,2" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnPickerOK" Content="OK" Width="75" Margin="0,0,5,0" IsEnabled="False"/>
                <Button Name="btnPickerCancel" Content="Cancel" Width="75"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
