<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    WindowStyle="None"
    SizeToContent="WidthAndHeight"
    ResizeMode="NoResize"
    MinWidth="280"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI\WPF\Themes\Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBackgroundColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon + Title text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleForegroundColor}"
                               VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- Close button -->
                <Button Name="btnTitleClose" Grid.Column="1" Content="&#x2715;"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="46"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundColor}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#9B2215"/>
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Icon + message -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Name="iconBorder" Width="30" Height="30" CornerRadius="15"
                            Margin="0,2,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Name="iconSymbol" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="14" Foreground="White"/>
                    </Border>

                    <TextBlock Name="txtMessage" Grid.Column="1"
                               TextWrapping="Wrap" MinWidth="240" MaxWidth="460"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Buttons -->
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,2,0,0">
                    <Button Name="btnYes"    MinWidth="78" Margin="0,0,8,0" Padding="8,3" Visibility="Collapsed">_Yes</Button>
                    <Button Name="btnNo"     MinWidth="78" Margin="0,0,8,0" Padding="8,3" Visibility="Collapsed">_No</Button>
                    <Button Name="btnOK"     MinWidth="78" Margin="0,0,8,0" Padding="8,3" Visibility="Collapsed">_OK</Button>
                    <Button Name="btnCancel" MinWidth="78" Margin="0,0,0,0" Padding="8,3" Visibility="Collapsed" IsCancel="True">_Cancel</Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
