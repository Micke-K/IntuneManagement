<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBox Name="txtIntuneAssignmentsExportPath" Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Root folder for exported objects" />
    <Button Grid.Column="2" Name="browseIntuneAssignmentsExportPath" Padding="5,2,5,2" Width="50"
            ToolTip="Select folder with exported objects">...</Button>
</Grid>
