<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="5,5,5,5" MinWidth="500" MinHeight="400" Grid.IsSharedSizeScope="True">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="PickerLabel" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Label Grid.Row="0" Grid.Column="0" Content="Search:" VerticalAlignment="Center" />
    <TextBox Grid.Row="0" Grid.Column="1" Name="txtGroupSearch" Margin="0,3,5,3" />
    <Button Grid.Row="0" Grid.Column="2" Name="btnGroupSearch" Content="Search" MinWidth="80" />

    <ListBox Grid.Row="1" Grid.ColumnSpan="3" Name="lstGroupResults" Margin="0,5,0,5"
             SelectionMode="Single" DisplayMemberPath="displayName"
             Background="{DynamicResource ControlBackgroundColor}" />

    <Label Grid.Row="2" Grid.Column="0" Content="Direction:" VerticalAlignment="Center" />
    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
        <RadioButton Name="rbGroupInclude" Content="Include" GroupName="GroupPickerDir" IsChecked="True" VerticalAlignment="Center" />
        <RadioButton Name="rbGroupExclude" Content="Exclude" GroupName="GroupPickerDir" Margin="15,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <Label Grid.Row="3" Grid.Column="0" Content="Filter:" VerticalAlignment="Center" />
    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="cbGroupFilter" Margin="0,3,0,3"
              DisplayMemberPath="Name" SelectedValuePath="Id" />

    <Label Grid.Row="4" Grid.Column="0" Content="Filter mode:" VerticalAlignment="Center" />
    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
        <RadioButton Name="rbGroupFilterInclude" Content="Include" GroupName="GroupPickerFilterDir" IsChecked="True" VerticalAlignment="Center" />
        <RadioButton Name="rbGroupFilterExclude" Content="Exclude" GroupName="GroupPickerFilterDir" Margin="15,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Intent only applies to app (mobileAppAssignments) targets. For non-
         app types the public command ignores this value, so the picker still
         shows it but with a tooltip explaining the scope. -->
    <Label Grid.Row="5" Grid.Column="0" Content="App intent:" VerticalAlignment="Center" ToolTip="Only applies when the target policy is an app (mobile app assignment). Ignored for Device Configuration, Compliance, scripts, etc." />
    <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Name="cbGroupIntent" Margin="0,3,0,3"
              DisplayMemberPath="Name" SelectedValuePath="Value"
              ToolTip="Required = auto-install. Available = visible in Company Portal. Uninstall = auto-remove. Available without enrollment = web/CP without MDM enrollment. Not available = hidden." />

    <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Name="btnGroupPickerOK"     Content="Add"    MinWidth="100" Margin="0,0,5,0" />
        <Button Name="btnGroupPickerCancel" Content="Cancel" MinWidth="100" />
    </StackPanel>
</Grid>
