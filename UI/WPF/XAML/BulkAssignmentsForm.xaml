<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,5,5" Grid.IsSharedSizeScope="True">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="TitleColumn" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,5,0">
            <Label Content="Action" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Add: union of current and selected. Replace: overwrite all current assignments. Remove: subtract selected from current." />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
            <RadioButton Name="rbBulkAssignAdd"     Content="Add"     GroupName="BulkAssignAction" IsChecked="True" VerticalAlignment="Center" />
            <RadioButton Name="rbBulkAssignReplace" Content="Replace" GroupName="BulkAssignAction" Margin="15,0,0,0" VerticalAlignment="Center" />
            <RadioButton Name="rbBulkAssignRemove"  Content="Remove"  GroupName="BulkAssignAction" Margin="15,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,5,0">
            <Label Content="Name filter" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Regex (or literal substring) matched against each policy's Name. Leave empty to target every listed policy." />
        </StackPanel>
        <TextBox Grid.Column="1" Grid.Row="1" Name="txtBulkAssignNameFilter" Margin="0,5,0,5"
                 Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,5,0">
            <Label Content="List by" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Group: pick whole categories (Configuration, Compliance, ...). API: pick individual policy types. Apps and Health Scripts are supported — configure per-policy fields via the App settings... button." />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
            <RadioButton Name="rbBulkAssignViewGroup" Content="Group" GroupName="BulkAssignView" IsChecked="True" VerticalAlignment="Center" />
            <RadioButton Name="rbBulkAssignViewType"  Content="API"   GroupName="BulkAssignView" Margin="15,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>

    <Grid Grid.Row="1" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <Label Content="Objects to update" />
                <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Select the policy types / groups to update" />
            </StackPanel>
            <DataGrid Grid.Row="1" Name="dgBulkAssignObjects" CanUserAddRows="False" AutoGenerateColumns="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource ControlBackgroundColor}" />
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <Label Content="Assignments to apply" />
                <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Targets that will be added / replaced / removed. Double-click a row to open settings." />
            </StackPanel>
            <DataGrid Grid.Row="1" Name="dgBulkAssignList" CanUserAddRows="False" AutoGenerateColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="{DynamicResource ControlBackgroundColor}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Target type" Binding="{Binding TargetTypeDisplay}" IsReadOnly="True" Width="Auto" />
                    <DataGridTextColumn Header="Group"       Binding="{Binding GroupName}"         IsReadOnly="True" Width="2*" />
                    <!-- Intent only applies when the policy being updated is an
                         app (mobileAppAssignments shape). Shown as a display
                         column here; the Intent picker in the Add dialog
                         drives the value, so this is read-only. -->
                    <DataGridTextColumn Header="Intent"      Binding="{Binding Intent}"            IsReadOnly="True" Width="Auto" />
                    <DataGridTextColumn Header="Filter"      Binding="{Binding FilterDisplay}"     IsReadOnly="True" Width="1*" />
                    <!-- "Settings" shows the count of per-platform settings tabs
                         currently configured for this row. 0 = Graph defaults.
                         Configure via the "App settings..." button below. -->
                    <DataGridTextColumn Header="App settings" Binding="{Binding SettingsDisplay}" IsReadOnly="True" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                <Button Name="btnBulkAssignAddGroup"     Content="Add group..."     MinWidth="120" Margin="0,0,5,0"
                        ToolTip="Pick an AAD group to include or exclude" />
                <Button Name="btnBulkAssignAddAllDev"    Content="All devices"      MinWidth="100" Margin="0,0,5,0"
                        ToolTip="Add the All Devices virtual target" />
                <Button Name="btnBulkAssignAddAllUsers"  Content="All users"        MinWidth="100" Margin="0,0,5,0"
                        ToolTip="Add the All Users virtual target" />
                <Button Name="btnBulkAssignSettings"     Content="App settings..."  MinWidth="120" Margin="0,0,5,0"
                        ToolTip="Configure per-platform app assignment settings for the selected row" />
                <Button Name="btnBulkAssignRemoveSel"    Content="Remove selected"  MinWidth="120"
                        ToolTip="Remove the highlighted row from the list above" />
            </StackPanel>
        </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Name="txtBulkAssignStatus" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextColor}" Opacity="0.8" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnBulkAssignApply" Content="Apply" MinWidth="100" Margin="5,0,0,0" />
            <Button Name="btnBulkAssignClose" Content="Close" MinWidth="100" Margin="5,0,0,0" />
        </StackPanel>
    </Grid>
</Grid>
