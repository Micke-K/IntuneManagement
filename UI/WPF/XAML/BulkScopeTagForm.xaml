<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,5,5" Grid.IsSharedSizeScope="True">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="TitleColumn" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,5,0">
            <Label Content="Action" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Add: union of current and selected. Replace: overwrite. Remove: subtract selected from current." />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
            <RadioButton Name="rbBulkScopeTagAdd"     Content="Add"     GroupName="BulkScopeTagAction" IsChecked="True" VerticalAlignment="Center" />
            <RadioButton Name="rbBulkScopeTagReplace" Content="Replace" GroupName="BulkScopeTagAction" Margin="15,0,0,0" VerticalAlignment="Center" />
            <RadioButton Name="rbBulkScopeTagRemove"  Content="Remove"  GroupName="BulkScopeTagAction" Margin="15,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,5,0">
            <Label Content="Cleanup orphans" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="In addition to the chosen action, strip any tag ids from each policy that no longer resolve to a real scope tag in the tenant. Can also be used standalone (Add with no tags selected)." />
        </StackPanel>
        <CheckBox Grid.Column="1" Grid.Row="1" Name="chkBulkScopeTagCleanupOrphans" VerticalAlignment="Center" Margin="0,5,0,5"
                  IsChecked="{Binding CleanupOrphans, Mode=TwoWay}" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,5,0">
            <Label Content="Name filter" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Regex (or literal substring) matched against each policy's Name. Leave empty to target every listed policy." />
        </StackPanel>
        <TextBox Grid.Column="1" Grid.Row="2" Name="txtBulkScopeTagNameFilter" Margin="0,5,0,5"
                 Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,5,0">
            <Label Content="List by" />
            <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Group: pick whole categories (Configuration, Compliance, ...). API: pick individual policy types." />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,5">
            <RadioButton Name="rbBulkScopeTagViewGroup" Content="Group" GroupName="BulkScopeTagView" IsChecked="True" VerticalAlignment="Center" />
            <RadioButton Name="rbBulkScopeTagViewType"  Content="API"   GroupName="BulkScopeTagView" Margin="15,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>

    <Grid Grid.Row="1" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <Label Content="Objects to update" />
                <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Select the policy types / groups that should be updated" />
            </StackPanel>
            <DataGrid Grid.Row="1" Name="dgBulkScopeTagObjects" CanUserAddRows="False" AutoGenerateColumns="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource ControlBackgroundColor}" />
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <Label Content="Available scope tags" />
                <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Double-click to add to the Selected list" />
            </StackPanel>
            <ListBox Grid.Row="1" Name="lstBulkScopeTagAvailable" DisplayMemberPath="Name" SelectionMode="Extended"
                     Background="{DynamicResource ControlBackgroundColor}" />
            <Grid Grid.Row="2" Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Selected scope tags" />
                    <Rectangle Style="{DynamicResource InfoIcon}" ToolTip="Tags to use with the chosen action. Double-click a row to remove it." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnBulkScopeTagAddTag" Content="Add &#8595;" MinWidth="80" Margin="0,0,5,0"
                            ToolTip="Move the highlighted available tags to the Selected list" />
                    <Button Name="btnBulkScopeTagRemoveTag" Content="Remove &#8593;" MinWidth="80"
                            ToolTip="Move the highlighted selected tags back to the Available list" />
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="3" Name="lstBulkScopeTagSelected" DisplayMemberPath="Name" SelectionMode="Extended"
                     Background="{DynamicResource ControlBackgroundColor}" />
        </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Name="txtBulkScopeTagStatus" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextColor}" Opacity="0.8" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnBulkScopeTagApply" Content="Apply" MinWidth="100" Margin="5,0,0,0" />
            <Button Name="btnBulkScopeTagClose" Content="Close" MinWidth="100" Margin="5,0,0,0" />
        </StackPanel>
    </Grid>
</Grid>
