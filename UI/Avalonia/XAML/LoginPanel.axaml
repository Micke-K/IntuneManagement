<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="5"
        Background="{DynamicResource WindowBackgroundColor}"
        Width="340">

    <!--
        Avalonia port of UI/WPF/XAML/LoginPanel.xaml. The WPF original used a Grid
        with dynamic RowDefinitions; we use a StackPanel so Add-CachedUser can
        just Children.Add($row) without managing row indices. The "Sign in with
        a different account" footer button is appended after the cached rows
        by Show-CachedAccountPicker.
    -->

    <StackPanel x:Name="grdAccounts" Orientation="Vertical" Margin="5,0,5,0"/>
</Border>
