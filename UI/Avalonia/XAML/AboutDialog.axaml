<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackgroundColor}"
        TextElement.Foreground="{DynamicResource TextColor}">
    <!--
        Avalonia port of UI/WPF/XAML/AboutDialog.xaml.

        WPF -> Avalonia translations:
          - <Hyperlink> has no Avalonia equivalent. Replaced with an inline
            Button using Classes="link" (style defined in Themes/Styles.axaml).
            Show-AboutDialog wires the Click handler to launch the URL.
          - Grid.IsSharedSizeScope / SharedSizeGroup don't exist in Avalonia.
            Dropped — module list still reads cleanly with a fixed first column
            and natural sizing for the rest. Revisit if module names get long
            enough to misalign in practice.
    -->
    <Grid Name="grdAbout" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="txtTitle" FontWeight="Bold" Margin="0,5,0,0"/>

        <TextBlock Grid.Row="1" Text="(c) 2022 Mikael Karlsson - MIT License" Margin="0,5,0,0"/>

        <StackPanel Grid.Row="2" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="See "/>
                <Button Name="linkSource" Classes="link" Content="GitHub"/>
                <TextBlock Text=" for more information."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Like the tool? "/>
                <Button Name="linkCoffee" Classes="link" Content="Buy me a coffee"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Name="txtViewTitle" Grid.Column="1" Margin="20,5,0,0"/>

        <TextBlock Name="txtViewDescription" Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                   VerticalAlignment="Top" Margin="20,5,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="3" Text="Loaded modules:" Margin="0,10,0,0"/>

        <ListBox Name="lstModules" SelectionMode="Single" Grid.Row="4" Grid.ColumnSpan="2"
                 MinHeight="200" MinWidth="500" Margin="0,5,0,5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"    Grid.Column="0"/>
                        <TextBlock Text="{Binding Version}" Grid.Column="1" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding Type}"    Grid.Column="2" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Border>
