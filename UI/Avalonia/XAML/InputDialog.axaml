<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10"
          ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto,Auto">

        <Label Name="txtLabel" Grid.Column="1" />
        <TextBox Name="txtValue" Grid.Column="1" Grid.Row="1" MinWidth="250" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Spacing="10">
            <Button IsDefault="True" Name="btnOk"     MinWidth="60" Content="_OK" />
            <Button IsCancel="True"  Name="btnCancel" MinWidth="60" Content="_Cancel" />
        </StackPanel>

    </Grid>
</Window>
