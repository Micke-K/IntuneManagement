<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Cloud"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundColor}">

    <!--
        Avalonia port of UI/WPF/XAML/CloudPickerMenu.xaml. Translation notes:
        - Window.Resources merging Default.xaml dropped — Avalonia loads themes
          globally via Application.Resources.MergedDictionaries.
        - SharedSizeGroup dropped (no Avalonia equivalent).
        - InfoIcon rectangle dropped.
        - FocusManager.FocusedElement binding dropped; Avalonia uses Focus()
          imperatively if needed.
        - ComboBox DisplayMemberPath / SelectedValuePath dropped — the PS code
          assigns an ItemTemplate and reads SelectedItem.Value directly.
    -->

    <Grid Width="380" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Cloud" Margin="0,5,5,0" VerticalAlignment="Center"
               ToolTip.Tip="Select the Microsoft cloud to sign in to: Public (Global), US Government (GCC High), US Government (DoD), or China (Vianet)."/>
        <ComboBox x:Name="cbCloud" DisplayMemberBinding="{Binding Name}" Grid.Column="1" Margin="0,5,5,0" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Select the Microsoft cloud to sign in to: Public (Global), US Government (GCC High), US Government (DoD), or China (Vianet)."/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnLogin"  Content="Sign in" Width="100" Margin="5,0,0,0" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Cancel"  Width="100" Margin="5,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
