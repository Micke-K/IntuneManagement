<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Avalonia port of UI/WPF/XAML/CompareFileOptions.xaml. Used as
        ccCompareInputOptions.Content when the user picks "File" in
        cbCompareInput. Slice 3d2.
    -->
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBox Name="txtCompareFile" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Name="browseCompareObject" Padding="5,2,5,2" Width="50"
            Content="..." ToolTip.Tip="Browse for file"/>
</Grid>
