<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="5">
    <!--
        Avalonia port of UI/WPF/XAML/BulkCopy.xaml (Bulk Copy, originally from
        the old project's Copy extension). Hosted via Show-ModalForm.

        WPF -> Avalonia translations applied (same set as BulkDeleteForm):
          - SharedSizeGroup dropped - explicit ColumnDefinition widths.
          - InfoIcon Rectangles are rendered as the info-icon glyph (Themes/Styles.axaml);
            the description sits on the wrapping StackPanel so hovering the label shows it too.
          - Inline DataGrid columns with a select-all header CheckBox.
    -->

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip.Tip="Specify the pattern of the source objects e.g. Test -">
        <Label Content="Source object name pattern"/>
        <TextBlock Classes="info-icon"/>
    </StackPanel>
    <TextBox Name="txtCopyFromPattern" Grid.Row="0" Grid.Column="1" Margin="0,5,0,0"/>

    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip.Tip="Specify the pattern of the new object e.g. Prod -">
        <Label Content="Copy object name pattern"/>
        <TextBlock Classes="info-icon"/>
    </StackPanel>
    <TextBox Name="txtCopyToPattern" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,5,0" VerticalAlignment="Top" ToolTip.Tip="Select the object types that should be copied">
        <Label Content="Objects to copy"/>
        <TextBlock Classes="info-icon"/>
    </StackPanel>

    <DataGrid CanUserResizeColumns="True" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="dgBulkCopyObjects"
              AutoGenerateColumns="False"
              CanUserReorderColumns="True"
              CanUserSortColumns="True"
              Margin="0,0,0,5">
        <DataGrid.Columns>
            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                <DataGridTemplateColumn.Header>
                    <CheckBox IsChecked="True"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ToolTip.Tip="Select/deselect all listed items"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Object type" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="btnStartCopy" Content="Copy"  Width="100" Margin="5,0,0,0"/>
        <Button Name="btnClose"     Content="Close" Width="100" Margin="5,0,0,0"/>
    </StackPanel>
</Grid>
