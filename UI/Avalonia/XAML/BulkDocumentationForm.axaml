<Grid xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="5">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl Name="tabDocumentation">
    <TabItem Header="Options">
      <Grid Margin="5" ColumnDefinitions="370,10,*">
        <StackPanel>
          <StackPanel Orientation="Horizontal" ToolTip.Tip="Output provider for the documentation (Word, HTML, Markdown, JSON, CSV)"><Label Content="Output format"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbDocumentationType" MinWidth="250" HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Output provider for the documentation (Word, HTML, Markdown, JSON, CSV)"/>
          <StackPanel Name="pnlDocumentationOutputFolder" IsVisible="False"><StackPanel Orientation="Horizontal" ToolTip.Tip="Root folder for output providers that need one (e.g. CSV)"><Label Content="Output folder"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseDocumentationOutputFolder" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for output folder"/><TextBox Name="txtDocumentationOutputFolder" ToolTip.Tip="Root folder for output providers that need one (e.g. CSV)"/></DockPanel></StackPanel>
          <StackPanel Orientation="Horizontal" ToolTip.Tip="Language for the documentation. Not all text is translated in non-English languages"><Label Content="Language"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbDocumentationLanguage" HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding EnglishName}" ToolTip.Tip="Language for the documentation. Not all text is translated in non-English languages"/>
          <StackPanel Orientation="Horizontal" ToolTip.Tip="Character used to separate property names from values"><Label Content="Property separator"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbDocumentationPropertySeparator" DisplayMemberBinding="{Binding Name}" Width="100" HorizontalAlignment="Left" ToolTip.Tip="Character used to separate property names from values"/>
          <StackPanel Orientation="Horizontal" ToolTip.Tip="Character used to separate objects in the documentation output"><Label Content="Object separator"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbDocumentationObjectSeparator" Width="140" HorizontalAlignment="Left" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Character used to separate objects in the documentation output"/>
          <StackPanel Name="pnlDocumentFilterLabel" Orientation="Horizontal" ToolTip.Tip="Filter policies by name or scope tag. Leave empty to document every selected policy"><Label Name="lblDocumentFilter" Content="Filter policy names or scope:tag"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtDocumentFilter" ToolTip.Tip="Filter policies by name or scope tag. Leave empty to document every selected policy"/>
          <StackPanel Name="pnlDocumentFromFolderLabel" Orientation="Horizontal" ToolTip.Tip="Document from previously exported files instead of fetching from Intune"><Label Name="lblDocumentFromFolder" Content="Source files (optional)"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel Name="pnlDocumentFromFolder"><Button Name="browseDocumentFromFolder" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for source folder"/><TextBox Name="txtDocumentFromFolder" ToolTip.Tip="Document from previously exported files instead of fetching from Intune"/></DockPanel>
        </StackPanel>
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal"><Label Content="Objects to document"/><StackPanel Name="pnlDocumentationListBy" Orientation="Horizontal"><StackPanel Orientation="Horizontal" Margin="20,0,0,0" ToolTip.Tip="Group: pick whole categories (Configuration, Compliance, ...). API: pick individual policy types"><Label Content="List by"/><TextBlock Classes="info-icon"/></StackPanel><RadioButton Name="rbBulkDocViewGroup" Content="Group" GroupName="BulkDocView" IsChecked="True" Margin="10,0"/><RadioButton Name="rbBulkDocViewType" Content="API" GroupName="BulkDocView"/></StackPanel></StackPanel>
          <DataGrid CanUserResizeColumns="True" Name="dgObjectsToDocument" Grid.Row="1" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTemplateColumn Width="Auto" CanUserSort="False"><DataGridTemplateColumn.Header><CheckBox IsChecked="True" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="Select/deselect all listed items"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Object type" Binding="{Binding Title}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem Header="Output Settings">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="5">
        <Grid ColumnDefinitions="210,250,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" ToolTip.Tip="Value displayed for unconfigured items. 'Don't change' leaves the source value as-is"><Label Content="Unconfigured text"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbNotConfiguredText" Grid.Column="1" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Value displayed for unconfigured items. 'Don't change' leaves the source value as-is"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" ToolTip.Tip="Exclude properties that are empty or set to Not configured">
              <Label Content="Skip unconfigured properties"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkSkipNotConfigured" Grid.Row="1" Grid.Column="1" ToolTip.Tip="Exclude properties that are empty or set to Not configured"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" ToolTip.Tip="Exclude properties whose value matches the property definition's default">
              <Label Content="Skip default values"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkSkipDefaultValues" Grid.Row="2" Grid.Column="1" ToolTip.Tip="Exclude properties whose value matches the property definition's default"/>
          <StackPanel Grid.Row="3" Orientation="Horizontal" ToolTip.Tip="Exclude properties marked as disabled. Disabled properties are still excluded when the same EntityKey is used on an enabled property">
              <Label Content="Skip disabled properties"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkSkipDisabled" Grid.Row="3" Grid.Column="1" ToolTip.Tip="Exclude properties marked as disabled. Disabled properties are still excluded when the same EntityKey is used on an enabled property"/>
          <StackPanel Grid.Row="4" Orientation="Horizontal" ToolTip.Tip="ADMX output value style — value only or value with label">
              <Label Content="ADMX output value"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><ComboBox Name="cbValueOutputProperty" Grid.Row="4" Grid.Column="1" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="ADMX output value style — value only or value with label"/>
          <StackPanel Grid.Row="5" Orientation="Horizontal" ToolTip.Tip="Set the unconfigured value when the property is not configured and the property definition has an unconfigured value defined">
              <Label Content="Set unconfigured value"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkSetUnconfiguredValue" Grid.Row="5" Grid.Column="1" ToolTip.Tip="Set the unconfigured value when the property is not configured and the property definition has an unconfigured value defined"/>
          <StackPanel Grid.Row="6" Orientation="Horizontal" ToolTip.Tip="Set the default value when the property is not configured and the property definition has a default value defined">
              <Label Content="Set default value"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkSetDefaultValue" Grid.Row="6" Grid.Column="1" ToolTip.Tip="Set the default value when the property is not configured and the property definition has a default value defined"/>
          <StackPanel Grid.Row="7" Orientation="Horizontal" ToolTip.Tip="Include script content in the documentation">
              <Label Content="Document scripts"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkIncludeScripts" Grid.Row="7" Grid.Column="1" ToolTip.Tip="Include script content in the documentation"/>
          <StackPanel Grid.Row="8" Orientation="Horizontal" ToolTip.Tip="Strip the signature block from PowerShell scripts to reduce documentation size">
              <Label Content="Remove script signature"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkExcludeScriptSignature" Grid.Row="8" Grid.Column="1" ToolTip.Tip="Strip the signature block from PowerShell scripts to reduce documentation size"/>
          <StackPanel Grid.Row="9" Orientation="Horizontal" ToolTip.Tip="Exclude assignments from the documentation">
              <Label Content="Skip assignments"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkExcludeAssignments" Grid.Row="9" Grid.Column="1" ToolTip.Tip="Exclude assignments from the documentation"/>
          <StackPanel Grid.Row="10" Orientation="Horizontal" ToolTip.Tip="Include the policy Id in the basic info section">
              <Label Content="Include policy ID"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkIncludePolicyId" Grid.Row="10" Grid.Column="1" ToolTip.Tip="Include the policy Id in the basic info section"/>
          <StackPanel Grid.Row="11" Orientation="Horizontal" ToolTip.Tip="Skip the document-info header written at the top of the document (Organization, generated by, and generated date)">
              <Label Content="Skip document info"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkSkipDocumentInfo" Grid.Row="11" Grid.Column="1" ToolTip.Tip="Skip the document-info header written at the top of the document (Organization, generated by, and generated date)"/>
          <StackPanel Grid.Row="12" Orientation="Horizontal" ToolTip.Tip="Policy types without a documentation template are listed with their raw properties instead of producing an empty page. When off, those types are skipped and a warning is written to the log.">
              <Label Content="Document unsupported types"/>
              <TextBlock Classes="info-icon"/>
          </StackPanel><CheckBox Name="chkFallbackDocumentation" Grid.Row="12" Grid.Column="1" ToolTip.Tip="Policy types without a documentation template are listed with their raw properties instead of producing an empty page. When off, those types are skipped and a warning is written to the log."/>
        </Grid>
        <StackPanel Name="pnlDocumentationOutputCSV" IsVisible="False" Margin="0,10,0,0"><Label Content="CSV"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Root folder where CSV files are written"><Label Content="Root folder"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseCSVDocumentationPath" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for CSV root folder"/><TextBox Name="txtCSVDocumentationPath" ToolTip.Tip="Root folder where CSV files are written"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Simple = Name and Value only. Extended = same as Raw Output. Custom = use the Custom properties list below"><Label Content="Properties"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbCSVDocumentationProperties" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Simple = Name and Value only. Extended = same as Raw Output. Custom = use the Custom properties list below"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Comma-separated list of properties to export. Must match property names from Raw Output"><Label Content="Custom properties"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtCSVCustomProperties" ToolTip.Tip="Comma-separated list of properties to export. Must match property names from Raw Output"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Character used to separate CSV columns"><Label Content="Delimiter"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbCSVDelimiter" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Character used to separate CSV columns"/><CheckBox Name="chkCSVAddObjectType" Content="Add object type to path" ToolTip.Tip="Write each object type into its own sub-folder under the root"/><CheckBox Name="chkCSVAddCompanyName" Content="Add organization to path" ToolTip.Tip="Add the organization name to the export path"/></StackPanel>
        <StackPanel Name="pnlDocumentationOutputJson" IsVisible="False" Margin="0,10,0,0"><Label Content="JSON"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Output JSON file path"><Label Content="Document name"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtJsonDocumentName" ToolTip.Tip="Output JSON file path"/><CheckBox Name="chkJsonOpenFile" Content="Open document" ToolTip.Tip="Open the document when generation is complete"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Single file = everything in one JSON; one file per object type = sub-files in the same folder"><Label Content="Output file"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbJsonOutputFileType" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Single file = everything in one JSON; one file per object type = sub-files in the same folder"/></StackPanel>
        <StackPanel Name="pnlDocumentationOutputHTML" IsVisible="False" Margin="0,10,0,0"><Label Content="HTML"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Output HTML file path"><Label Content="Document name"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseHTMLDocumentName" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for output HTML file"/><TextBox Name="txtHTMLDocumentName" ToolTip.Tip="Output HTML file path"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Optional CSS file used to style the HTML output"><Label Content="CSS file"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseHTMLCSSFile" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for CSS file"/><TextBox Name="txtHTMLCSSFile" ToolTip.Tip="Optional CSS file used to style the HTML output"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Title property for the HTML document"><Label Content="Title"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtHTMLTitleProperty" ToolTip.Tip="Title property for the HTML document"/><CheckBox Name="chkHTMLOpenFile" Content="Open document" ToolTip.Tip="Open the document when generation is complete"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Single file, one file per object type, or one file per object"><Label Content="Output file"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbHTMLDocumentFileType" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Single file, one file per object type, or one file per object"/></StackPanel>
        <!-- Atlassian mirrors HTML minus the CSS row: the provider emits Confluence
             storage format, which carries no stylesheet. -->
        <StackPanel Name="pnlDocumentationOutputAtlassian" IsVisible="False" Margin="0,10,0,0"><Label Content="Atlassian"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Output file path for the Confluence storage-format document"><Label Content="Document name"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseAtlassianDocumentName" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for output Atlassian file"/><TextBox Name="txtAtlassianDocumentName" ToolTip.Tip="Output file path for the Confluence storage-format document"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Title property for the Atlassian document"><Label Content="Title"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtAtlassianTitleProperty" ToolTip.Tip="Title property for the Atlassian document"/><CheckBox Name="chkAtlassianOpenFile" Content="Open document" ToolTip.Tip="Open the document when generation is complete"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Single file or one file per object"><Label Content="Output file"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbAtlassianDocumentFileType" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Single file or one file per object"/></StackPanel>
        <StackPanel Name="pnlDocumentationOutputMarkdown" IsVisible="False" Margin="0,10,0,0"><Label Content="Markdown"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Output Markdown file path"><Label Content="Document name"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseMDDocumentName" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for output Markdown file"/><TextBox Name="txtMDDocumentName" ToolTip.Tip="Output Markdown file path"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Optional CSS file referenced by the Markdown output"><Label Content="CSS file"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseMDCSSFile" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for CSS file"/><TextBox Name="txtMDCSSFile" ToolTip.Tip="Optional CSS file referenced by the Markdown output"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Title property for the Markdown document"><Label Content="Title"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtMDTitleProperty" ToolTip.Tip="Title property for the Markdown document"/><CheckBox Name="chkMDIncludeCSS" Content="Include CSS" ToolTip.Tip="Embed CSS contents into the Markdown file"/><CheckBox Name="chkMDOpenFile" Content="Open document" ToolTip.Tip="Open the document when generation is complete"/><CheckBox Name="chkMDDocumentSkipDate" Content="Skip generated date" ToolTip.Tip="Skip the generated-on date in the Markdown header"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Single file, one file per object type, or one file per object"><Label Content="Output file"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbMDDocumentFileType" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Single file, one file per object type, or one file per object"/></StackPanel>
        <StackPanel Name="pnlDocumentationOutputWord" IsVisible="False" Margin="0,10,0,0"><Label Content="Word"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Output Word document path. Default: %MyDocuments%\%Organization%-%Date%.docx. Special folders and environment variables can be used"><Label Content="Document name"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseWordDocumentName" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for output Word document"/><TextBox Name="txtWordDocumentName" ToolTip.Tip="Output Word document path. Default: %MyDocuments%\%Organization%-%Date%.docx. Special folders and environment variables can be used"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Word template (.dotx) used as the base. Normal.dotx is used when empty"><Label Content="Template"/><TextBlock Classes="info-icon"/></StackPanel><DockPanel><Button Name="browseWordDocumentTemplate" Content="..." DockPanel.Dock="Right" Width="45" ToolTip.Tip="Browse for Word template (.dotx)"/><TextBox Name="txtWordDocumentTemplate" ToolTip.Tip="Word template (.dotx) used as the base. Normal.dotx is used when empty"/></DockPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Simple = Name and Value only. Extended = same as Raw Output. Custom = use the Custom properties list below"><Label Content="Properties"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbWordExportProperties" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Simple = Name and Value only. Extended = same as Raw Output. Custom = use the Custom properties list below"/><StackPanel Name="spWordCustomProperties"><StackPanel Orientation="Horizontal" ToolTip.Tip="Comma-separated list of properties to export. Must match property names from Raw Output"><Label Content="Custom properties"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordCustomDisplayProperties" ToolTip.Tip="Comma-separated list of properties to export. Must match property names from Raw Output"/></StackPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Document format — DOCX, Strict Open XML, or PDF"><Label Content="Format"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbWordDocumentFormat" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Document format — DOCX, Strict Open XML, or PDF"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Full = full value of every setting. Limited = truncate long values. Basic = basic info and assignments only, no settings"><Label Content="Output level"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbWordDocumentationLevel" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Full = full value of every setting. Limited = truncate long values. Basic = basic info and assignments only, no settings"/><StackPanel Name="gdWordDocumentationLimitOptions"><CheckBox Name="chkWordDocumentationLimitAttach" Content="Attach full value when truncated" ToolTip.Tip="When a value is truncated, attach the full value as a text file embedded in the document"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Maximum value length before truncation. Default 100"><Label Content="Max value length"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordDocumentationLimitMaxLength" Width="80" HorizontalAlignment="Left" ToolTip.Tip="Maximum value length before truncation. Default 100"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Length to truncate to. Default = same as Max value length. 0 = skip truncated text and only include the attached value (attach must be on)"><Label Content="Truncated length"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordDocumentationLimitTruncateLength" Width="80" HorizontalAlignment="Left" ToolTip.Tip="Length to truncate to. Default = same as Max value length. 0 = skip truncated text and only include the attached value (attach must be on)"/></StackPanel><CheckBox Name="chkWordAddCategories" Content="Include categories" ToolTip.Tip="Include category headers in the documentation when available"/><CheckBox Name="chkWordAddSubCategories" Content="Include sub-categories" ToolTip.Tip="Include sub-category headers in the documentation when available"/><CheckBox Name="chkWordOpenDocument" Content="Open document" ToolTip.Tip="Open Word and activate the document when generation is complete"/><CheckBox Name="chkWordAttachJsonFile" Content="Attach JSON file" ToolTip.Tip="Attach the source JSON to the Word document"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Title property for the Word document"><Label Content="Title"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordTitleProperty" ToolTip.Tip="Title property for the Word document"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Subject property for the Word document"><Label Content="Subject"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordSubjectProperty" ToolTip.Tip="Subject property for the Word document"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Content-control values, format: prop1=value;prop2=value;..."><Label Content="Content controls"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordContentControls" ToolTip.Tip="Content-control values, format: prop1=value;prop2=value;..."/><StackPanel Orientation="Horizontal" ToolTip.Tip="Cover page to apply when no template is set. Default: Ion (Dark)"><Label Content="Cover page"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordCoverPage" ToolTip.Tip="Cover page to apply when no template is set. Default: Ion (Dark)"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style names for H1, H2, and H3"><Label Content="Header styles (1 / 2 / 3)"/><TextBlock Classes="info-icon"/></StackPanel><StackPanel Orientation="Horizontal"><TextBox Name="txtWordHeader1Style" Width="150" ToolTip.Tip="Word style name for Header 1"/><TextBox Name="txtWordHeader2Style" Width="150" ToolTip.Tip="Word style name for Header 2"/><TextBox Name="txtWordHeader3Style" Width="150" ToolTip.Tip="Word style name for Header 3"/></StackPanel><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style name applied to tables"><Label Content="Table style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordTableStyle" ToolTip.Tip="Word style name applied to tables"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style for the table header row. Default: base font + 2pt"><Label Content="Table header style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordTableHeaderStyle" ToolTip.Tip="Word style for the table header row. Default: base font + 2pt"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style for table category header rows. Default: base font + 2pt + italic"><Label Content="Category header style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordCategoryHeaderStyle" ToolTip.Tip="Word style for table category header rows. Default: base font + 2pt + italic"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style for table sub-category header rows. Default: base font + italic"><Label Content="Sub-category header style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordSubCategoryHeaderStyle" ToolTip.Tip="Word style for table sub-category header rows. Default: base font + italic"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style for body text inside tables. Default: base font"><Label Content="Table text style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordTableTextStyle" ToolTip.Tip="Word style for body text inside tables. Default: base font"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Place table captions above or below the table"><Label Content="Table caption position"/><TextBlock Classes="info-icon"/></StackPanel><ComboBox Name="cbWordTableCaptionPosition" DisplayMemberBinding="{Binding Name}" ToolTip.Tip="Place table captions above or below the table"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style for script tables. Defaults to the document Table style"><Label Content="Script table style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordScriptTableStyle" ToolTip.Tip="Word style for script tables. Defaults to the document Table style"/><StackPanel Orientation="Horizontal" ToolTip.Tip="Word style for script text. Default: HTML Code"><Label Content="Script font style"/><TextBlock Classes="info-icon"/></StackPanel><TextBox Name="txtWordScriptStyle" ToolTip.Tip="Word style for script text. Default: HTML Code"/></StackPanel>
      </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Raw Output"><Grid Margin="5" RowDefinitions="*,Auto"><TextBox Name="txtDocumentationRawData" AcceptsReturn="True" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Name="btnPreviewDocumentation" Content="Preview" Width="90" Margin="4" ToolTip.Tip="Preview the documentation for the selected object"/><Button Name="btnCopyBasicDocumentation" Content="Copy basic" Width="90" Margin="4" ToolTip.Tip="Copy the basic info to the clipboard"/><Button Name="btnCopySettingsDocumentation" Content="Copy settings" Width="100" Margin="4" ToolTip.Tip="Copy the settings info to the clipboard"/><Button Name="btnCopyRawDocumentation" Content="Copy all" Width="90" Margin="4" ToolTip.Tip="Copy all info to the clipboard"/></StackPanel></Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Name="btnDocument" Content="Start" Width="100" Margin="5" ToolTip.Tip="Start documentation"/><Button Name="btnClose" Content="Close" Width="100" Margin="5"/></StackPanel>
</Grid>
