<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="5">
    <!--
        Avalonia port of UI/WPF/XAML/BulkScopeTagForm.xaml. Hosted via Show-ModalForm
        — Apply / Close live in this Grid and call back into
        Show-GraphBulkScopeTagForm.

        WPF -> Avalonia translations (same set as BulkExport/BulkImport/BulkDelete):
          - Window/UserControl host -> Grid (modal-form host owns the chrome).
          - SharedSizeGroup dropped — explicit ColumnDefinition Width="Auto"/"*".
          - InfoIcon Rectangles are rendered as the info-icon glyph (Themes/Styles.axaml);
            the description sits on the wrapping StackPanel so hovering the label shows it too.
          - DataGrid columns inlined (no Get-GridCheckboxColumn header trick —
            chkSelectAll toolbar checkbox replaces it; default checked since
            scope-tag rows pre-select per the WPF original).
          - DynamicResource brushes (ControlBackgroundColor / TextColor) dropped —
            Avalonia theme drives ListBox / TextBlock backgrounds.
    -->

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top property block: Action / Cleanup / Filter / List-by -->
    <Grid Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip.Tip="Add: union of current and selected. Replace: overwrite. Remove: subtract selected from current.">
            <Label Content="Action"/>
            <TextBlock Classes="info-icon"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,5,0,5">
            <RadioButton Name="rbBulkScopeTagAdd"     Content="Add"     GroupName="BulkScopeTagAction" IsChecked="True" VerticalAlignment="Center"/>
            <RadioButton Name="rbBulkScopeTagReplace" Content="Replace" GroupName="BulkScopeTagAction" Margin="15,0,0,0" VerticalAlignment="Center"/>
            <RadioButton Name="rbBulkScopeTagRemove"  Content="Remove"  GroupName="BulkScopeTagAction" Margin="15,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip.Tip="In addition to the chosen action, strip any tag ids from each policy that no longer resolve to a real scope tag in the tenant. Can also be used standalone (Add with no tags selected).">
            <Label Content="Cleanup orphans"/>
            <TextBlock Classes="info-icon"/>
        </StackPanel>
        <CheckBox Grid.Row="1" Grid.Column="1" Name="chkBulkScopeTagCleanupOrphans"
                  VerticalAlignment="Center" Margin="0,5,0,5"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip.Tip="Regex (or literal substring) matched against each policy's Name. Leave empty to target every listed policy.">
            <Label Content="Name filter"/>
            <TextBlock Classes="info-icon"/>
        </StackPanel>
        <TextBox Grid.Row="2" Grid.Column="1" Name="txtBulkScopeTagNameFilter"
                 Margin="0,5,0,5"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip.Tip="Group: pick whole categories (Configuration, Compliance, ...). API: pick individual policy types.">
            <Label Content="List by"/>
            <TextBlock Classes="info-icon"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,5,0,5">
            <RadioButton Name="rbBulkScopeTagViewGroup" Content="Group" GroupName="BulkScopeTagView" IsChecked="True" VerticalAlignment="Center"/>
            <RadioButton Name="rbBulkScopeTagViewType"  Content="API"   GroupName="BulkScopeTagView" Margin="15,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>

    <!-- Middle: object DataGrid (left) + dual-list scope-tag picker (right) -->
    <Grid Grid.Row="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3" ToolTip.Tip="Select the policy types / groups that should be updated">
                <Label Content="Objects to update"/>
                <TextBlock Classes="info-icon"/>
            </StackPanel>
            <DataGrid CanUserResizeColumns="True" Grid.Row="1" Name="dgBulkScopeTagObjects"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="True"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      ToolTip.Tip="Select/deselect all listed items"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn     Header="Object type" Binding="{Binding Title}"   IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3" ToolTip.Tip="Double-click to add to the Selected list">
                <Label Content="Available scope tags"/>
                <TextBlock Classes="info-icon"/>
            </StackPanel>
            <ListBox Grid.Row="1" Name="lstBulkScopeTagAvailable"
                     DisplayMemberBinding="{Binding Name}"
                     SelectionMode="Multiple"/>
            <Grid Grid.Row="2" Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Selected scope tags" VerticalAlignment="Center"
                       ToolTip.Tip="Tags to use with the chosen action. Double-click a row to remove it."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <Button Name="btnBulkScopeTagAddTag" Content="Add &#8595;" MinWidth="80"
                            ToolTip.Tip="Move the highlighted available tags to the Selected list"/>
                    <Button Name="btnBulkScopeTagRemoveTag" Content="Remove &#8593;" MinWidth="80"
                            ToolTip.Tip="Move the highlighted selected tags back to the Available list"/>
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="3" Name="lstBulkScopeTagSelected"
                     DisplayMemberBinding="{Binding Name}"
                     SelectionMode="Multiple"/>
        </Grid>
    </Grid>

    <!-- Bottom: status + Select-all toggle + Apply / Close -->
    <Grid Grid.Row="2" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Name="txtBulkScopeTagStatus" VerticalAlignment="Center"
                   Opacity="0.8"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnBulkScopeTagApply" Content="Apply" Width="100" Margin="5,0,0,0"/>
            <Button Name="btnBulkScopeTagClose" Content="Close" Width="100" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Grid>
