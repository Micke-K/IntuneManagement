<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Intentionally empty.

        Theme brushes for both Light and Dark live in Brushes.axaml under
        ResourceDictionary.ThemeDictionaries. Avalonia auto-selects the right
        variant based on Application.RequestedThemeVariant — no separate
        Dark.axaml load needed.

        Kept as a placeholder for any dark-only style overrides that aren't
        expressible as a brush swap (rare).
    -->
</Styles>
